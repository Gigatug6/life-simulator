# Toolchain Rust pour compiler le moteur de simulation en WebAssembly (rien sur l'hôte).
FROM rust:1-slim-bookworm
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN rustup target add wasm32-unknown-unknown \
 && groupadd -o -g ${HOST_GID} dev && useradd -o -m -u ${HOST_UID} -g ${HOST_GID} dev \
 && mkdir -p /usr/local/cargo/registry && chmod -R a+rwX /usr/local/cargo
USER dev
ENV CARGO_HOME=/home/dev/.cargo CARGO_TARGET_DIR=/work/wasm/target
WORKDIR /work
